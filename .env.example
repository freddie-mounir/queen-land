# Server
PORT=3000

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The mailbox the message is sent FROM.
# For Gmail this must be the authenticated account, and SMTP_PASS must be a
# Google "App Password" (16 characters), not your normal account password.
SMTP_USER=feryfrodo2014@gmail.com
SMTP_PASS=your_gmail_app_password

# Visible sender and recipient
MAIL_FROM=feryfrodo2014@gmail.com
MAIL_TO=info@queenland-group.com
